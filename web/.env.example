# dram/web environment. Copy to `.env.local` and adjust.

# Base URL for the real REST API. Defaults to `/api` (proxied to the deployed
# CloudFront distro in dev via vite.config.ts).
VITE_API_BASE_URL=/api

# Use the in-browser mock API. TRUE by default so dev/preview work offline;
# set to `false` to talk to the real backend.
VITE_USE_MOCK=true

# Cognito (real-auth mode only). Fill from the CDK stack outputs. Leaving these
# blank keeps auth in demo-only mode (see AUTH_CONFIGURED in src/lib/auth.ts).
VITE_COGNITO_USER_POOL_ID=
VITE_COGNITO_CLIENT_ID=
